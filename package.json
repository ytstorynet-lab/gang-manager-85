{
  "name": "gang-manager-85",
  "productName": "Gang Manager 85",
  "version": "0.1.0",
  "private": true,
  "description": "Gang Manager '85: run a crew in Rico City, 1985. A crime management game for Windows PC.",
  "author": "ytstorynet",
  "license": "UNLICENSED",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:web && npm run build:electron",
    "build:web": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "preview": "vite preview",
    "electron": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:electron": "playwright test --config playwright.electron.config.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "sim": "tsx tools/sim.ts",
    "sim:batch": "tsx tools/sim-batch.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "eslint": "10.14.0",
    "pixi.js": "8.22.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
